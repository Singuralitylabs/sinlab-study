{
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git add *)",
      "Bash(git mv *)",
      "Bash(git check-ignore *)",
      "Bash(git ls-files *)",
      "Bash(git rev-parse *)",
      "Bash(git fetch *)",

      "Bash(bun run *)",
      "Bash(bun install *)",
      "Bash(bun add *)",
      "Bash(bun pm *)",
      "Bash(bun test *)",
      "Bash(bunx vitest *)",
      "Bash(bunx biome *)",
      "Bash(bunx tsc *)",

      "Bash(supabase gen types *)",
      "Bash(npx supabase gen types *)",
      "Bash(bunx supabase gen types *)",
      "Bash(supabase projects list *)",
      "Bash(supabase migration list *)",
      "Bash(supabase status *)",
      "Bash(supabase db diff *)",
      "Bash(supabase inspect db *)",

      "Bash(vercel ls *)",
      "Bash(vercel list *)",
      "Bash(vercel projects ls *)",
      "Bash(vercel inspect *)",
      "Bash(vercel logs *)",
      "Bash(vercel env ls *)",
      "Bash(vercel whoami *)",

      "Bash(ls *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(echo *)",
      "Bash(cp *)",
      "Bash(mkdir *)",
      "Bash(jq *)",
      "Bash(lsof *)",

      "Read",
      "Glob",
      "Grep"
    ],
    "deny": ["Bash(rm -rf *)", "Bash(git push --force *)", "Bash(git push -f *)"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^mcp__.+__execute_sql$",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/allow-readonly-sql.mjs"
          }
        ]
      }
    ]
  }
}
