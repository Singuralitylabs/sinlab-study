# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=xxxx
SUPABASE_SERVICE_ROLE_KEY=xxxx
SUPABASE_PROJECT_ID=xxxx

# Gemini API（AIレビュー機能用。SDK は @google/genai）
# GEMINI_API_KEY: 会員（status=active）向け。本番では有料ティア（Billing紐づけ）のキーを設定する
# GEMINI_API_KEY_TRIAL: お試しユーザー（status=trial）向け無料ティア。
#   未設定時は GEMINI_API_KEY にフォールバックするため、ローカルの1キー運用でも動作する。
#   プレースホルダ値のままだとフォールバックしないため、使う場合のみコメントを外して実キーを入れる
GEMINI_API_KEY=xxxx
# GEMINI_API_KEY_TRIAL=

# Slack通知（初回ログイン時の承認依頼通知・Stripe支払い失敗通知）
# 未設定の場合は通知をスキップ
SLACK_NOTIFICATION_WEBHOOK_URL=https://hooks.slack.com/services/xxxx/xxxx/xxxx

# 受講生向けメール通知（Resend。登録・承認・有料会員化・解約のトランザクションメール）
# いずれかが未設定の場合はメール送信をスキップ（主処理には影響しない）。
# RESEND_API_KEY はサーバー側でのみ扱う（NEXT_PUBLIC_ を付けない）。
# EMAIL_FROM_ADDRESS は認証済みドメインの返信不可アドレス。ドメイン認証前の開発時は
#   onboarding@resend.dev を使う（Resend アカウントのメールアドレス宛てにのみ届く）
# 本文のリンクは下の NEXT_PUBLIC_APP_URL を起点に生成する
# RESEND_API_KEY=re_xxxx
# EMAIL_FROM_ADDRESS=onboarding@resend.dev

# Stripe（月額サブスクリプション決済）
# STRIPE_ENABLED: "true"以外（未設定含む）は決済機能を無効化するフィーチャーフラグ（フェイルクローズ）。
# 本番（Vercel）ではHobbyプラン規約対応のため一時停止中（詳細はAGENTS.md参照）
STRIPE_ENABLED=true
STRIPE_SECRET_KEY=sk_test_xxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxx
STRIPE_PRICE_ID=price_xxxx
NEXT_PUBLIC_APP_URL=http://localhost:3000
