{
  "name": "sinlab-web-skillup-service",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.8",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "db:types": "sh -e -c '[ -f .env.local ] && . ./.env.local; : \"${SUPABASE_PROJECT_ID:?SUPABASE_PROJECT_ID is not set}\"; npx supabase gen types --lang=typescript --project-id \"$SUPABASE_PROJECT_ID\" --schema public > app/types/lib/database.types.ts'",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:all": "bun run build && bun run db:types && bun run lint && bun run format && bun run check && bun run test"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@google/genai": "^2.20.0",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.114.0",
    "@uiw/react-codemirror": "^4.25.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hast-util-to-text": "^4.0.2",
    "highlight.js": "~11.12.0",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.39.0",
    "next": "16.3.4",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "react-pdf": "^10.5.0",
    "react-youtube": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "stripe": "^22.6.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "unist-util-visit": "^5.1.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.20",
    "@types/hast": "^3.0.5",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "supabase": "^2.116.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
